          "displayMode": "table",
          "placement": "right"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "((thread_router_neighbor_link_margin_db * on(source_router) group_left(source_ext_address) label_replace(label_replace(thread_router_present, \"source_router\", \"$1\", \"router_id\", \"(.*)\"), \"source_ext_address\", \"$1\", \"ext_address\", \"(.*)\")) * on(source_ext_address) group_left(source_name,source_location) (0 * topk by (source_ext_address) (1, label_replace(label_replace(label_replace(thread_device_name{kind=\"router\"}, \"source_ext_address\", \"$1\", \"ext_address\", \"(.*)\"), \"source_name\", \"$1\", \"name\", \"(.*)\"), \"source_location\", \"$1\", \"location\", \"(.*)\")) + 1)) * on(target_ext_address) group_left(target_name,target_location) (0 * topk by (target_ext_address) (1, label_replace(label_replace(label_replace(thread_device_name{kind=\"router\"}, \"target_ext_address\", \"$1\", \"ext_address\", \"(.*)\"), \"target_name\", \"$1\", \"name\", \"(.*)\"), \"target_location\", \"$1\", \"location\", \"(.*)\")) + 1)",
          "legendFormat": "{{source_name}} ({{source_location}}) -> {{target_name}} ({{target_location}})",
          "refId": "A"
        }
      ],
      "title": "Router Neighbor Link Margin",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
