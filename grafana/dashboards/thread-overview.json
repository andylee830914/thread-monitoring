          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Current Router Graph Health",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "indexByName": {
              "location": 0,
              "name": 1,
              "router_id": 2,
              "status": 3,
              "reliable_neighbors": 4,
              "leader_route_cost": 5,
              "weak_edge_ratio": 6,
              "ext_address": 7,
              "rloc16": 8
            },
            "renameByName": {
              "ext_address": "ext address",
              "leader_route_cost": "leader route cost",
              "location": "location",
              "name": "device",
              "reliable_neighbors": "reliable neighbors",
              "router_id": "router",
              "status": "status",
              "weak_edge_ratio": "weak edge ratio"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "location"
              },
              {
                "field": "device"
              }
            ]
          }
        }
      ],
      "type": "table"
    },
